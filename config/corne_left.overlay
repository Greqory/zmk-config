/*
 * Wired split UART overlay for left (central) half.
 * Uses TRRS cable on ProMicro pins D2 (P0.17) and D3 (P0.20).
 *
 * Crossing through the straight-through TRRS cable:
 *   Left TX (P0.17/D2) → wire → Right D2 (P0.17) = Right RX
 *   Left RX (P0.20/D3) ← wire ← Right D3 (P0.20) = Right TX
 */

#include <dt-bindings/pinctrl/nrf-pinctrl.h>

/* Disable I2C on these pins to avoid conflict */
&i2c0 {
    status = "disabled";
};

&pinctrl {
    uart0_default: uart0_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 17)>,
                    <NRF_PSEL(UART_RX, 0, 20)>;
        };
    };
    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 17)>,
                    <NRF_PSEL(UART_RX, 0, 20)>;
            low-power-enable;
        };
    };
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart0_default>;
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
};

/ {
    wired_split {
        compatible = "zmk,wired-split";
        device = <&uart0>;
    };
};

/*
 * Wired split UART overlay for right (peripheral) half.
 * Half-duplex mode: single data line on ProMicro D2 (P0.17) via TRRS.
 * The Corne Chocolate v2.1 only routes one data pin through TRRS.
 */

#include <dt-bindings/pinctrl/nrf-pinctrl.h>

/* Disable I2C on these pins to avoid conflict */
&i2c0 {
    status = "disabled";
};

&pinctrl {
    uart0_default: uart0_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 17)>,
                    <NRF_PSEL(UART_RX, 0, 17)>;
            /* Open-drain TX: disconnect on HIGH so the remote side can
             * also drive the shared TRRS data line without bus contention. */
            nordic,drive-mode = <NRF_DRIVE_S0D1>;
            bias-pull-up;
        };
    };
    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 17)>,
                    <NRF_PSEL(UART_RX, 0, 17)>;
            low-power-enable;
        };
    };
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart0_default>;
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
};

/ {
    wired_split {
        compatible = "zmk,wired-split";
        device = <&uart0>;
        half-duplex;
    };
};

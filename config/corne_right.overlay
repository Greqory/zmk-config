/*
 * Wired split UART overlay for right (peripheral) half.
 * Full-duplex UART via TRRS (4-pole cable required):
 *   D3 (P0.20) = TX → TRRS → Left RX
 *   D2 (P0.17) = RX ← TRRS ← Left TX
 */

#include <dt-bindings/pinctrl/nrf-pinctrl.h>

/* Disable I2C — uart0 shares the same nRF SERIAL0 peripheral */
&i2c0 {
    status = "disabled";
};

&pinctrl {
    uart0_default: uart0_default {
        /* Delete stale group2 (TX on P0.06) inherited from nice_nano-pinctrl.dtsi */
        /delete-node/ group2;
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 20)>,
                    <NRF_PSEL(UART_RX, 0, 17)>;
        };
    };
    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 20)>,
                    <NRF_PSEL(UART_RX, 0, 17)>;
            low-power-enable;
        };
    };
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart0_default>;
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
};

/ {
    wired_split {
        compatible = "zmk,wired-split";
        device = <&uart0>;
    };
};

/*
 * Wired split UART overlay for right (peripheral) half.
 * Uses TRRS cable on ProMicro pins D2 (P0.17) and D3 (P0.20).
 *
 * TX/RX swapped relative to left side for cross-connection through TRRS:
 *   Right TX (P0.20/D3) → wire → Left D3 (P0.20) = Left RX
 *   Right RX (P0.17/D2) ← wire ← Left D2 (P0.17) = Left TX
 */

#include <dt-bindings/pinctrl/nrf-pinctrl.h>

/* Disable I2C on these pins to avoid conflict */
&i2c0 {
    status = "disabled";
};

&pinctrl {
    uart0_default: uart0_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 20)>,
                    <NRF_PSEL(UART_RX, 0, 17)>;
        };
    };
    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 20)>,
                    <NRF_PSEL(UART_RX, 0, 17)>;
            low-power-enable;
        };
    };
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart0_default>;
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
};

/ {
    wired_split {
        compatible = "zmk,wired-split";
        device = <&uart0>;
    };
};
